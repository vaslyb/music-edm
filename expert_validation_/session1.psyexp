      <CodeComponent name="codeMusicJS" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="&amp;#10;&amp;#10;  " valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="// create and play the music&amp;#10;sndMusic = new sound.Sound({&amp;#10;      win: psychoJS.window,&amp;#10;      value: 'A',&amp;#10;      secs: (- 1),&amp;#10;      });&amp;#10;sndMusic.setVolume(1.0);&amp;#10;&amp;#10;sndMusic.setValue(audioFile);&amp;#10;sndMusic.setVolume(1.0);&amp;#10;sndMusic.play(-1);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# NOTE: python and JS are NOT linked in this code block&amp;#10;#       any changes made to one side will not affect the other&amp;#10;&amp;#10;# define the undefined parameter in python&amp;#10;undefined = None&amp;#10;&amp;#10;# create and play the music&amp;#10;sndMusic = sound.Sound(&amp;#10;    'A', &amp;#10;    secs=-1, &amp;#10;    stereo=True, &amp;#10;    hamming=True, &amp;#10;    speaker='sndMusic',    name='sndMusic'&amp;#10;)&amp;#10;sndMusic.setVolume(1.0)&amp;#10;&amp;#10;sndMusic.setSound(audioFile, hamming=True)&amp;#10;sndMusic.setVolume(1.0, log=False)&amp;#10;sndMusic.seek(0)&amp;#10;sndMusic.play(-1)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="// stop the music&amp;#10;sndMusic.stop();" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# stop the music&amp;#10;sndMusic.pause()" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="codeMusicJS" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="codeTrial" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="sliderMoved = false;&amp;#10;continueClicked = false;&amp;#10;trial_msg = ((&quot;How representative is this song of\n&quot; + genre.toString()) + &quot;?&quot;);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="sliderMoved = False&amp;#10;continueClicked = False&amp;#10;&amp;#10;# setup the trial message&amp;#10;trial_msg = &quot;How representative is this song of\n&quot; + str(genre) + &quot;?&quot;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="# Check if the slider has been moved&amp;#10;if slider.getRating() != undefined:&amp;#10;    sliderMoved = True&amp;#10;&amp;#10;# Check if the continue button is clicked and the slider has been moved&amp;#10;if mouseTrial.isPressedIn(buttonContinue_Trial) and sliderMoved:&amp;#10;    continueClicked = True&amp;#10;    continueRoutine = False&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if ((slider.getRating() !== undefined)) {&amp;#10;    sliderMoved = true;&amp;#10;}&amp;#10;if ((mouseTrial.isPressedIn(buttonContinue_Trial) &amp;&amp; sliderMoved)) {&amp;#10;    continueClicked = true;&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="skip_break = true;&amp;#10;if (((((trials.thisN % 20) === 19) &amp;&amp; (trials.thisN !== 0)) &amp;&amp; (trials.thisN !== 199))) {&amp;#10;    skip_break = false;&amp;#10;    console.log(&quot;Break time! Showing break screen.&quot;);&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="skip_break = True # assume no break&amp;#10;&amp;#10;# every 20 trials activate a break&amp;#10;if trials.thisN % 20 == 19 and trials.thisN != 0 and trials.thisN != 199:&amp;#10;    skip_break = False&amp;#10;    print(&quot;Break time! Showing break screen.&quot;)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="codeTrial" valType="code" updates="None" name="name"/>
      </CodeComponent>
